# Keep diffs stable across Windows, Linux and CI.
* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.sln text eol=lf
*.cshtml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.ps1 text eol=crlf
*.png binary
*.ico binary
