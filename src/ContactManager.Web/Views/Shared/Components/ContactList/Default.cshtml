@model IReadOnlyList<ContactManager.Web.Models.Contact>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No contacts have been added yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Date of birth</th>
                    <th>Married</th>
                    <th>Phone</th>
                    <th>Salary</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var contact in Model)
                {
                    <tr>
                        <td>@contact.Name</td>

                        <td>
                            @contact.DateOfBirth.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @(contact.Married ? "Yes" : "No")
                        </td>

                        <td>@contact.Phone</td>

                        <td>
                            @contact.Salary.ToString("F2")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}