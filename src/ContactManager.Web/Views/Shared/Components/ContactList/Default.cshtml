@using ContactManager.Web.Models
@model ContactListViewModel

@{
    var result = Model.Result;
    var query = Model.Query;

    string NextDirection(ContactSortColumn column)
    {
        if (query.SortBy == column &&
            query.SortDirection == SortDirection.Asc)
        {
            return nameof(SortDirection.Desc);
        }

        return nameof(SortDirection.Asc);
    }

    string SortIndicator(ContactSortColumn column)
    {
        if (query.SortBy != column)
        {
            return string.Empty;
        }

        return query.SortDirection == SortDirection.Asc
            ? " ↑"
            : " ↓";
    }

    var startItem =
        result.TotalCount == 0
            ? 0
            : ((result.Page - 1) * result.PageSize) + 1;

    var endItem =
        Math.Min(
            result.Page * result.PageSize,
            result.TotalCount);

    var startPage =
        Math.Max(1, result.Page - 2);

    var endPage =
        Math.Min(
            result.TotalPages,
            result.Page + 2);
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div class="text-muted">
        Showing @startItem-@endItem
        of @result.TotalCount contacts
    </div>

    <form
        asp-controller="Contacts"
        asp-action="Index"
        method="get"
        class="d-flex align-items-center gap-2">

        <input
            type="hidden"
            name="page"
            value="1" />

        <input
            type="hidden"
            name="sortBy"
            value="@query.SortBy" />

        <input
            type="hidden"
            name="sortDirection"
            value="@query.SortDirection" />

        <label
            for="pageSize"
            class="form-label mb-0">
            Rows:
        </label>

        <select
            id="pageSize"
            name="pageSize"
            class="form-select form-select-sm"
            onchange="this.form.submit()">

            <option value="2"
                    selected="@(result.PageSize == 2)">
                2
            </option>

            <option value="5"
                    selected="@(result.PageSize == 5)">
                5
            </option>

            <option value="10"
                    selected="@(result.PageSize == 10)">
                10
            </option>

            <option value="20"
                    selected="@(result.PageSize == 20)">
                20
            </option>

            <option value="50"
                    selected="@(result.PageSize == 50)">
                50
            </option>

        </select>

    </form>

</div>

@if (result.Items.Count == 0)
{
    <div class="alert alert-info">
        No contacts have been added yet.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead>
                <tr>

                    <th>
                        <a
                            asp-controller="Contacts"
                            asp-action="Index"
                            asp-route-page="1"
                            asp-route-pageSize="@result.PageSize"
                            asp-route-sortBy="Name"
                            asp-route-sortDirection="@NextDirection(ContactSortColumn.Name)"
                            class="text-decoration-none text-dark">

                            Name@SortIndicator(ContactSortColumn.Name)

                        </a>
                    </th>

                    <th>
                        <a
                            asp-controller="Contacts"
                            asp-action="Index"
                            asp-route-page="1"
                            asp-route-pageSize="@result.PageSize"
                            asp-route-sortBy="DateOfBirth"
                            asp-route-sortDirection="@NextDirection(ContactSortColumn.DateOfBirth)"
                            class="text-decoration-none text-dark">

                            Date of birth@SortIndicator(ContactSortColumn.DateOfBirth)

                        </a>
                    </th>

                    <th>
                        <a
                            asp-controller="Contacts"
                            asp-action="Index"
                            asp-route-page="1"
                            asp-route-pageSize="@result.PageSize"
                            asp-route-sortBy="Married"
                            asp-route-sortDirection="@NextDirection(ContactSortColumn.Married)"
                            class="text-decoration-none text-dark">

                            Married@SortIndicator(ContactSortColumn.Married)

                        </a>
                    </th>

                    <th>
                        <a
                            asp-controller="Contacts"
                            asp-action="Index"
                            asp-route-page="1"
                            asp-route-pageSize="@result.PageSize"
                            asp-route-sortBy="Phone"
                            asp-route-sortDirection="@NextDirection(ContactSortColumn.Phone)"
                            class="text-decoration-none text-dark">

                            Phone@SortIndicator(ContactSortColumn.Phone)

                        </a>
                    </th>

                    <th>
                        <a
                            asp-controller="Contacts"
                            asp-action="Index"
                            asp-route-page="1"
                            asp-route-pageSize="@result.PageSize"
                            asp-route-sortBy="Salary"
                            asp-route-sortDirection="@NextDirection(ContactSortColumn.Salary)"
                            class="text-decoration-none text-dark">

                            Salary@SortIndicator(ContactSortColumn.Salary)

                        </a>
                    </th>

                </tr>
            </thead>

            <tbody>

                @foreach (var contact in result.Items)
                {
                    <tr>

                        <td>
                            @contact.Name
                        </td>

                        <td>
                            @contact.DateOfBirth.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @(contact.Married ? "Yes" : "No")
                        </td>

                        <td>
                            @contact.Phone
                        </td>

                        <td>
                            @contact.Salary.ToString("F2")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    @if (result.TotalPages > 1)
    {
        <nav
            aria-label="Contacts pagination"
            class="mt-3">

            <ul class="pagination">

                <li class="page-item
                    @(!result.HasPreviousPage ? "disabled" : "")">

                    <a
                        class="page-link"
                        asp-controller="Contacts"
                        asp-action="Index"
                        asp-route-page="@(result.Page - 1)"
                        asp-route-pageSize="@result.PageSize"
                        asp-route-sortBy="@query.SortBy"
                        asp-route-sortDirection="@query.SortDirection">

                        Previous

                    </a>

                </li>

                @for (var pageNumber = startPage;
                      pageNumber <= endPage;
                      pageNumber++)
                {
                    <li class="page-item
                        @(pageNumber == result.Page ? "active" : "")">

                        <a
                            class="page-link"
                            asp-controller="Contacts"
                            asp-action="Index"
                            asp-route-page="@pageNumber"
                            asp-route-pageSize="@result.PageSize"
                            asp-route-sortBy="@query.SortBy"
                            asp-route-sortDirection="@query.SortDirection">

                            @pageNumber

                        </a>

                    </li>
                }

                <li class="page-item
                    @(!result.HasNextPage ? "disabled" : "")">

                    <a
                        class="page-link"
                        asp-controller="Contacts"
                        asp-action="Index"
                        asp-route-page="@(result.Page + 1)"
                        asp-route-pageSize="@result.PageSize"
                        asp-route-sortBy="@query.SortBy"
                        asp-route-sortDirection="@query.SortDirection">

                        Next

                    </a>

                </li>

            </ul>

        </nav>
    }
}