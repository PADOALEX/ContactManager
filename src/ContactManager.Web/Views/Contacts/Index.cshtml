@model ContactManager.Web.Models.ContactsIndexViewModel

@{
    ViewData["Title"] = "Contacts";
}

<section class="app-page">
    <div class="container app-container">

        <div class="page-heading">
            <div>
                <div class="eyebrow">Contact database</div>

                <h1 class="page-title">
                    Contact Manager
                </h1>

                <p class="page-subtitle">
                    Import contacts from CSV, review the stored data,
                    and manage records without leaving the table.
                </p>
            </div>

            <div class="page-heading-badge">
                <span class="status-dot"></span>
                SQL Server connected
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div
                class="alert app-alert app-alert-success"
                role="alert">
                <div class="app-alert-icon">
                    ✓
                </div>

                <div>
                    <strong>Import completed</strong>
                    <div>@successMessage</div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div
                class="alert app-alert app-alert-danger"
                role="alert">
                <div class="app-alert-icon">
                    !
                </div>

                <div>
                    <strong>Unable to complete the request</strong>
                    <div>@Model.ErrorMessage</div>
                </div>
            </div>
        }

        @if (Model.ImportErrors.Count > 0)
        {
            <div
                class="alert app-alert app-alert-danger"
                role="alert">

                <div class="app-alert-icon">
                    !
                </div>

                <div class="w-100">
                    <strong>CSV import failed</strong>

                    <div class="mt-1 mb-2">
                        Fix the following rows and upload the file again.
                    </div>

                    <ul class="mb-0 ps-3">
                        @foreach (var error in Model.ImportErrors)
                        {
                            <li>
                                Row @error.RowNumber:
                                @error.Message
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <section class="app-card upload-card mb-4">
            <div class="app-card-body">
                <div class="row align-items-center g-4">

                    <div class="col-lg-5">
                        <div class="section-kicker">
                            CSV import
                        </div>

                        <h2 class="section-title">
                            Add contacts in one upload
                        </h2>

                        <p class="section-description mb-0">
                            Choose a CSV file with the required columns.
                            The file is validated on the server before
                            any records are written to the database.
                        </p>
                    </div>

                    <div class="col-lg-7">
                        <form
                            asp-controller="Contacts"
                            asp-action="Import"
                            method="post"
                            enctype="multipart/form-data">

                            <div class="upload-panel">
                                <div class="mb-3">
                                    <label
                                        for="csvFile"
                                        class="form-label fw-semibold">
                                        CSV file
                                    </label>

                                    <input
                                        id="csvFile"
                                        name="file"
                                        type="file"
                                        accept=".csv,text/csv"
                                        class="form-control app-file-input"
                                        required />

                                    <div class="form-text mt-2">
                                        Required:
                                        Name, Date of birth, Married,
                                        Phone, Salary
                                    </div>
                                </div>

                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                    <div class="small text-muted">
                                        Maximum file size: 5 MB
                                    </div>

                                    <button
                                        type="submit"
                                        class="btn btn-primary app-primary-btn">
                                        Upload CSV
                                    </button>
                                </div>
                            </div>

                        </form>
                    </div>

                </div>
            </div>
        </section>

        <div
            id="ajaxAntiforgeryToken"
            class="d-none">
            @Html.AntiForgeryToken()
        </div>

        @await Component.InvokeAsync(
            "ContactList",
            new { query = Model.Query })

    </div>
</section>

@section Scripts
{
    <script
        src="~/js/contacts.js"
        asp-append-version="true">
    </script>
}
