@using PADO.ContactFlow.Web.Models
@using System.Globalization
@model ContactListViewModel

@{
    var result = Model.Result;
    var query = Model.Query;

    string NextDirection(ContactSortColumn column)
    {
        if (query.SortBy == column &&
            query.SortDirection == SortDirection.Asc)
        {
            return nameof(SortDirection.Desc);
        }

        return nameof(SortDirection.Asc);
    }

    string SortIndicator(ContactSortColumn column)
    {
        if (query.SortBy != column)
        {
            return string.Empty;
        }

        return query.SortDirection == SortDirection.Asc
            ? " ↑"
            : " ↓";
    }

    var startItem =
        result.TotalCount == 0
            ? 0
            : ((result.Page - 1) * result.PageSize) + 1;

    var endItem =
        Math.Min(
            result.Page * result.PageSize,
            result.TotalCount);

    var startPage =
        Math.Max(1, result.Page - 2);

    var endPage =
        Math.Min(
            result.TotalPages,
            result.Page + 2);
}

<section class="app-card contacts-card">
    <div class="app-card-body">

        <div class="contacts-card-header">
            <div>
                <div class="section-kicker">
                    Database records
                </div>

                <h2 class="section-title mb-1">
                    Contacts
                </h2>

                <p class="section-description mb-0">
                    Search and sort across all records using the server controls below.
                    Use the quick tools to refine only the current page.
                </p>
            </div>

            <div class="contact-stats">
                <div class="stat-chip">
                    <span class="stat-label">
                        Total
                    </span>

                    <strong>
                        @result.TotalCount
                    </strong>
                </div>

                <div class="stat-chip">
                    <span class="stat-label">
                        Page
                    </span>

                    <strong>
                        @result.Page / @result.TotalPages
                    </strong>
                </div>
            </div>
        </div>

        <form asp-controller="Contacts" asp-action="Index" method="get"
              class="row g-2 align-items-end mb-3 server-search-form" role="search">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@result.PageSize" />
            <input type="hidden" name="sortBy" value="@query.SortBy" />
            <input type="hidden" name="sortDirection" value="@query.SortDirection" />
            <div class="col-12 col-md-3">
                <label for="serverFilter" class="form-label">Search field</label>
                <select class="form-select" id="serverFilter" name="filterBy">
                    @foreach (var column in Enum.GetValues<ContactFilterColumn>())
                    {
                        <option value="@column" selected="@(query.FilterBy == column)">@(column == ContactFilterColumn.All ? "All fields" : column == ContactFilterColumn.DateOfBirth ? "Date of birth" : column.ToString())</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label for="serverSearch" class="form-label">Search all contacts</label>
                <input class="form-control" id="serverSearch" type="search" name="search"
                       maxlength="100" placeholder="Name, phone, date, salary…" value="@query.Search" />
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index" asp-controller="Contacts">Reset</a>
            </div>
        </form>
        <div class="table-toolbar">
            <div class="table-toolbar-summary">
                Showing
                <strong>@startItem-@endItem</strong>
                of
                <strong>@result.TotalCount</strong>
                contacts
            </div>

            <form
                asp-controller="Contacts"
                asp-action="Index"
                method="get"
                class="rows-form">

                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="sortBy" value="@query.SortBy" />
                <input type="hidden" name="sortDirection" value="@query.SortDirection" />
                <input type="hidden" name="search" value="@query.Search" />
                <input type="hidden" name="filterBy" value="@query.FilterBy" />

                <label
                    for="pageSize"
                    class="form-label mb-0">
                    Rows per page
                </label>

                <select
                    id="pageSize"
                    name="pageSize"
                    class="form-select form-select-sm"
                    onchange="this.form.submit()">

                    <option value="2" selected="@(result.PageSize == 2)">2</option>
                    <option value="5" selected="@(result.PageSize == 5)">5</option>
                    <option value="10" selected="@(result.PageSize == 10)">10</option>
                    <option value="20" selected="@(result.PageSize == 20)">20</option>
                    <option value="50" selected="@(result.PageSize == 50)">50</option>
                </select>
            </form>
        </div>

        @if (result.Items.Count > 0)
        {
            <div class="client-tools">
                <div class="client-tools-heading">
                    <div>
                        <div class="client-tools-title">
                            Quick page tools
                        </div>

                        <div class="small text-muted">
                            Filter and sort only this page instantly.
                        </div>
                    </div>

                    <div
                        id="clientMatchCount"
                        class="client-match-count">
                        @result.Items.Count of @result.Items.Count rows match
                    </div>
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label
                            for="clientFilterColumn"
                            class="form-label">
                            Filter column
                        </label>

                        <select
                            id="clientFilterColumn"
                            class="form-select">
                            <option value="all">All columns</option>
                            <option value="name">Name</option>
                            <option value="dateOfBirth">Date of birth</option>
                            <option value="married">Married</option>
                            <option value="phone">Phone</option>
                            <option value="salary">Salary</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label
                            for="clientFilterText"
                            class="form-label">
                            Search
                        </label>

                        <input
                            id="clientFilterText"
                            type="search"
                            class="form-control"
                            autocomplete="off"
                            placeholder="Search current page..." />
                    </div>

                    <div class="col-12 col-md-2">
                        <label
                            for="clientSortColumn"
                            class="form-label">
                            Client sort
                        </label>

                        <select
                            id="clientSortColumn"
                            class="form-select">
                            <option value="">Server order</option>
                            <option value="name">Name</option>
                            <option value="dateOfBirth">Date of birth</option>
                            <option value="married">Married</option>
                            <option value="phone">Phone</option>
                            <option value="salary">Salary</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-2">
                        <label
                            for="clientSortDirection"
                            class="form-label">
                            Direction
                        </label>

                        <select
                            id="clientSortDirection"
                            class="form-select">
                            <option value="asc">Ascending</option>
                            <option value="desc">Descending</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-1 d-grid">
                        <button
                            id="clearClientTools"
                            type="button"
                            class="btn btn-outline-secondary">
                            Clear
                        </button>
                    </div>
                </div>
            </div>
        }

        <div
            id="contactActionMessage"
            class="alert app-action-message d-none"
            role="alert">
        </div>

        @if (result.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    CM
                </div>

                <h3 class="h5">
                    @(query.Search is null ? "No contacts yet" : "No matching contacts")
                </h3>

                <p class="text-muted mb-0">
                    No matching records. Change the search, create a contact, or import CSV.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive contacts-table-wrap">
                <table
                    id="contactsTable"
                    class="table contacts-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>
                                <a
                                    asp-controller="Contacts"
                                    asp-action="Index"
                                    asp-route-page="1"
                                    asp-route-pageSize="@result.PageSize"
                                    asp-route-search="@query.Search"
                                    asp-route-filterBy="@query.FilterBy"
                                    asp-route-sortBy="Name"
                                    asp-route-sortDirection="@NextDirection(ContactSortColumn.Name)"
                                    class="sort-link">
                                    Name@(SortIndicator(ContactSortColumn.Name))
                                </a>
                            </th>

                            <th>
                                <a
                                    asp-controller="Contacts"
                                    asp-action="Index"
                                    asp-route-page="1"
                                    asp-route-pageSize="@result.PageSize"
                                    asp-route-search="@query.Search"
                                    asp-route-filterBy="@query.FilterBy"
                                    asp-route-sortBy="DateOfBirth"
                                    asp-route-sortDirection="@NextDirection(ContactSortColumn.DateOfBirth)"
                                    class="sort-link">
                                    Date of birth@(SortIndicator(ContactSortColumn.DateOfBirth))
                                </a>
                            </th>

                            <th>
                                <a
                                    asp-controller="Contacts"
                                    asp-action="Index"
                                    asp-route-page="1"
                                    asp-route-pageSize="@result.PageSize"
                                    asp-route-search="@query.Search"
                                    asp-route-filterBy="@query.FilterBy"
                                    asp-route-sortBy="Married"
                                    asp-route-sortDirection="@NextDirection(ContactSortColumn.Married)"
                                    class="sort-link">
                                    Married@(SortIndicator(ContactSortColumn.Married))
                                </a>
                            </th>

                            <th>
                                <a
                                    asp-controller="Contacts"
                                    asp-action="Index"
                                    asp-route-page="1"
                                    asp-route-pageSize="@result.PageSize"
                                    asp-route-search="@query.Search"
                                    asp-route-filterBy="@query.FilterBy"
                                    asp-route-sortBy="Phone"
                                    asp-route-sortDirection="@NextDirection(ContactSortColumn.Phone)"
                                    class="sort-link">
                                    Phone@(SortIndicator(ContactSortColumn.Phone))
                                </a>
                            </th>

                            <th>
                                <a
                                    asp-controller="Contacts"
                                    asp-action="Index"
                                    asp-route-page="1"
                                    asp-route-pageSize="@result.PageSize"
                                    asp-route-search="@query.Search"
                                    asp-route-filterBy="@query.FilterBy"
                                    asp-route-sortBy="Salary"
                                    asp-route-sortDirection="@NextDirection(ContactSortColumn.Salary)"
                                    class="sort-link">
                                    Salary@(SortIndicator(ContactSortColumn.Salary))
                                </a>
                            </th>

                            <th class="text-end">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody id="contactsTableBody">
                        @foreach (var contact in result.Items)
                        {
                            <tr
                                data-contact-id="@contact.Id"
                                data-name="@contact.Name"
                                data-date-of-birth="@contact.DateOfBirth.ToString("yyyy-MM-dd")"
                                data-married="@(contact.Married ? "true" : "false")"
                                data-phone="@contact.Phone"
                                data-salary="@contact.Salary.ToString(CultureInfo.InvariantCulture)">

                                <td>
                                    <span
                                        class="view-value contact-name"
                                        data-display="name">
                                        @contact.Name
                                    </span>

                                    <input
                                        type="text"
                                        class="form-control form-control-sm edit-control d-none"
                                        data-input="name"
                                        maxlength="200"
                                        value="@contact.Name" />
                                </td>

                                <td>
                                    <span
                                        class="view-value text-nowrap"
                                        data-display="dateOfBirth">
                                        @contact.DateOfBirth.ToString("yyyy-MM-dd")
                                    </span>

                                    <input
                                        type="date"
                                        class="form-control form-control-sm edit-control d-none"
                                        data-input="dateOfBirth"
                                        value="@contact.DateOfBirth.ToString("yyyy-MM-dd")"
                                        style="min-width: 145px;" />
                                </td>

                                <td>
                                    <span
                                        class="view-value status-badge @(contact.Married ? "status-badge-positive" : "status-badge-neutral")"
                                        data-display="married">
                                        @(contact.Married ? "Yes" : "No")
                                    </span>

                                    <select
                                        class="form-select form-select-sm edit-control d-none"
                                        data-input="married"
                                        style="min-width: 100px;">
                                        <option value="true" selected="@contact.Married">Yes</option>
                                        <option value="false" selected="@(!contact.Married)">No</option>
                                    </select>
                                </td>

                                <td>
                                    <span
                                        class="view-value text-nowrap"
                                        data-display="phone">
                                        @contact.Phone
                                    </span>

                                    <input
                                        type="text"
                                        class="form-control form-control-sm edit-control d-none"
                                        data-input="phone"
                                        maxlength="50"
                                        value="@contact.Phone"
                                        style="min-width: 170px;" />
                                </td>

                                <td>
                                    <span
                                        class="view-value salary-value"
                                        data-display="salary">
                                        @contact.Salary.ToString(
                                            "N2",
                                            CultureInfo.InvariantCulture)
                                    </span>

                                    <input
                                        type="text"
                                        inputmode="decimal"
                                        pattern="(?:0|[0-9]{1,16})(?:\.[0-9]{1,2})?"
                                        class="form-control form-control-sm edit-control d-none"
                                        data-input="salary"
                                        value="@contact.Salary.ToString(
                                            "F2",
                                            CultureInfo.InvariantCulture)"
                                        style="min-width: 130px;" />
                                </td>

                                <td class="text-end text-nowrap">
                                    <div class="view-actions action-buttons">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-primary edit-contact-btn">
                                            Edit
                                        </button>

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger delete-contact-btn">
                                            Delete
                                        </button>
                                    </div>

                                    <div class="edit-actions action-buttons d-none">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-success save-contact-btn">
                                            Save
                                        </button>

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-secondary cancel-edit-btn">
                                            Cancel
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr
                            id="noClientMatchesRow"
                            class="d-none">
                            <td
                                colspan="6"
                                class="text-center text-muted py-5">
                                No rows on this page match your filter.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @if (result.TotalPages > 1)
            {
                <div class="pagination-shell">
                    <div class="small text-muted">
                        Server-side pagination
                    </div>

                    <nav aria-label="Contacts pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!result.HasPreviousPage ? "disabled" : "")">
                                <a
                                    class="page-link"
                                    asp-controller="Contacts"
                                    asp-action="Index"
                                    asp-route-page="@(result.Page - 1)"
                                    asp-route-pageSize="@result.PageSize"
                                    asp-route-search="@query.Search"
                                    asp-route-filterBy="@query.FilterBy"
                                    asp-route-sortBy="@query.SortBy"
                                    asp-route-sortDirection="@query.SortDirection">
                                    Previous
                                </a>
                            </li>

                            @for (var pageNumber = startPage;
                                  pageNumber <= endPage;
                                  pageNumber++)
                            {
                                <li class="page-item @(pageNumber == result.Page ? "active" : "")">
                                    <a
                                        class="page-link"
                                        asp-controller="Contacts"
                                        asp-action="Index"
                                        asp-route-page="@pageNumber"
                                        asp-route-pageSize="@result.PageSize"
                                        asp-route-search="@query.Search"
                                        asp-route-filterBy="@query.FilterBy"
                                        asp-route-sortBy="@query.SortBy"
                                        asp-route-sortDirection="@query.SortDirection">
                                        @pageNumber
                                    </a>
                                </li>
                            }

                            <li class="page-item @(!result.HasNextPage ? "disabled" : "")">
                                <a
                                    class="page-link"
                                    asp-controller="Contacts"
                                    asp-action="Index"
                                    asp-route-page="@(result.Page + 1)"
                                    asp-route-pageSize="@result.PageSize"
                                    asp-route-search="@query.Search"
                                    asp-route-filterBy="@query.FilterBy"
                                    asp-route-sortBy="@query.SortBy"
                                    asp-route-sortDirection="@query.SortDirection">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }

    </div>
</section>
