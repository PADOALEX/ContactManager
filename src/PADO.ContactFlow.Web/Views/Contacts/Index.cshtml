@model PADO.ContactFlow.Web.Models.ContactsIndexViewModel

@{
    ViewData["Title"] = "Contacts";
}

<section class="app-page">
    <div class="container app-container">

        <div class="page-heading">
            <div>
                <div class="eyebrow">Contact workspace</div>

                <h1 class="page-title">
                    PADO ContactFlow
                </h1>

                <p class="page-subtitle">
                    Import contacts from CSV, review the stored data,
                    and manage records without leaving the table.
                </p>
            </div>

            <div class="page-heading-badge">
                <span class="status-dot"></span>
                ASP.NET Core MVC · Dapper
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div
                class="alert app-alert app-alert-success"
                role="alert">
                <div class="app-alert-icon">
                    ✓
                </div>

                <div>
                    <strong>Import completed</strong>
                    <div>@successMessage</div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div
                class="alert app-alert app-alert-danger"
                role="alert">
                <div class="app-alert-icon">
                    !
                </div>

                <div>
                    <strong>Unable to complete the request</strong>
                    <div>@Model.ErrorMessage</div>
                </div>
            </div>
        }

        @if (Model.ImportErrors.Count > 0)
        {
            <div
                class="alert app-alert app-alert-danger"
                role="alert">

                <div class="app-alert-icon">
                    !
                </div>

                <div class="w-100">
                    <strong>CSV import failed</strong>

                    <div class="mt-1 mb-2">
                        Fix the following rows and upload the file again.
                    </div>

                    <p class="small mb-2">@Model.CsvRowsRead data rows checked. <strong>0 imported</strong> — this upload is atomic.</p>
                    <div class="table-responsive csv-error-scroll">
                        <table class="table table-sm table-bordered mb-0" aria-label="CSV import errors">
                            <thead><tr><th scope="col">CSV line</th><th scope="col">Problem</th></tr></thead>
                            <tbody>
                                @foreach (var error in Model.ImportErrors)
                                {
                                    <tr><td>@error.RowNumber</td><td>@error.Message</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <section class="app-card upload-card mb-4">
            <div class="app-card-body">
                <div class="row align-items-center g-4">

                    <div class="col-lg-5">
                        <div class="section-kicker">
                            CSV import
                        </div>

                        <h2 class="section-title">
                            Add contacts in one upload
                        </h2>

                        <p class="section-description mb-0">
                            Choose a CSV file with the required columns.
                            UTF-8 (with or without BOM); up to 5 MB and 10,000 rows.
                            All rows must be valid and phones must be unique. Any error rolls back the whole upload.
                        </p>
                    </div>

                    <div class="col-lg-7">
                        <form
                            id="csvImportForm"
                            asp-controller="Contacts"
                            asp-action="Import"
                            method="post"
                            enctype="multipart/form-data">

                            <div class="upload-panel">
                                <div class="mb-3">
                                    <label
                                        for="csvFile"
                                        class="form-label fw-semibold">
                                        CSV file
                                    </label>

                                    <input
                                        id="csvFile"
                                        name="file"
                                        type="file"
                                        accept=".csv,text/csv"
                                        class="form-control app-file-input"
                                        required />

                                    <div class="form-text mt-2">
                                        Required:
                                        Name, Date of birth, Married,
                                        Phone, Salary
                                    </div>
                                </div>

                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                    <div class="small text-muted">
                                        Maximum file size: 5 MB
                                    </div>

                                    <button
                                        type="submit"
                                        class="btn btn-primary app-primary-btn">
                                        <span class="idle-text">Upload CSV</span>
                                        <span class="busy-text d-none"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Importing…</span>
                                    </button>
                                </div>
                            </div>

                        </form>
                    </div>

                </div>
            </div>
        </section>

        <div
            id="ajaxAntiforgeryToken"
            class="d-none">
            @Html.AntiForgeryToken()
        </div>

        <div id="contactEndpoints" class="d-none"
             data-create-url="@Url.Action("Create", "Contacts")"
             data-update-url="@Url.Action("Update", "Contacts")"
             data-delete-url="@Url.Action("Delete", "Contacts")"></div>

        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
            <div>
                <h2 class="h5 mb-1">Your contacts</h2>
                <p class="small text-muted mb-0">Create individual records or find existing ones across the entire database.</p>
            </div>
            <button type="button" class="btn btn-primary app-primary-btn" data-bs-toggle="modal" data-bs-target="#createContactModal">
                + New contact
            </button>
        </div>

        @await Component.InvokeAsync(
            "ContactList",
            new { query = Model.Query })

    </div>
</section>

<div class="modal fade" id="createContactModal" tabindex="-1" aria-labelledby="createContactLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createContactForm" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="createContactLabel">New contact</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="createContactMessage" class="alert alert-danger d-none" role="alert" aria-live="polite"></div>
                    <div class="row g-3">
                        <div class="col-12"><label for="createName" class="form-label">Name</label>
                            <input id="createName" name="name" type="text" class="form-control" maxlength="200" required /></div>
                        <div class="col-md-6"><label for="createBirth" class="form-label">Date of birth</label>
                            <input id="createBirth" name="dateOfBirth" type="date" class="form-control" required /></div>
                        <div class="col-md-6"><label for="createMarried" class="form-label">Married</label>
                            <select id="createMarried" name="married" class="form-select"><option value="false">No</option><option value="true">Yes</option></select></div>
                        <div class="col-md-6"><label for="createPhone" class="form-label">Phone (unique)</label>
                            <input id="createPhone" name="phone" type="tel" class="form-control" maxlength="50" required /></div>
                        <div class="col-md-6"><label for="createSalary" class="form-label">Salary</label>
                            <input id="createSalary" name="salary" type="number" min="0" step="0.01" class="form-control" required /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create contact</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <script
        src="~/js/contacts.js"
        asp-append-version="true">
    </script>
}
